}</style>
  <style data-nocturne="base">/*
 * Nocturne — base stylesheet (issue #5).
 *
 * This is the ONLY stylesheet that every spec consumes unconditionally.
 * It is a token-driven reset + typography skeleton: each rule reads from
 * CSS custom properties that the renderer inlines on \`:root\` from the
 * active AestheticSpec. There is no spec-specific CSS in this file —
 * DESIGN.md forbids a shared "house style" beyond structural glue.
 *
 * Tokens consumed (all inlined by \`renderPage\`):
 *   --bg, --fg, --muted, --accent, --hairline
 *   --font-headline, --font-body, --font-label, --font-mono
 *   --space-base, --column-gap, --column-count-desktop, --max-width
 *   --severity-high, --severity-med, --severity-low  (only when severity_style="colored-dot")
 *
 * Anything that looks aesthetic here (sizes, weights) is either structural
 * (e.g. a 1em leading baseline) or a *default* that a per-spec stylesheet
 * is free to override. Per DESIGN.md, per-spec CSS files are intentionally
 * NOT shipped in v0 — we see how far token-driven + base.css carries us.
 */

/* ---------- Reset (modern normalize, trimmed) ----------- */

*, *::before, *::after { box-sizing: border-box; }

html, body, h1, h2, h3, h4, h5, h6, p, figure, blockquote, dl, dd, ol, ul {
  margin: 0;
}

ol, ul { padding: 0; list-style: none; }

img, picture, svg { max-width: 100%; display: block; }

button {
  font: inherit;
  color: inherit;
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
}

a { color: inherit; text-decoration: underline; text-underline-offset: 0.15em; }
a:hover { text-decoration-thickness: 2px; }

/* ---------- Page skeleton (token-driven) ---------- */

:root {
  color-scheme: light;
}

html {
  writing-mode: var(--writing-mode, horizontal-tb);
  -webkit-text-size-adjust: 100%;
}

/*
 * Outer body is a neutral desk surface so the sheet reads as a physical
 * object on screen. In print \`print.css\` removes this background — the
 * printer provides its own.
 */
body {
  background: #e5e5e5;
  color: var(--fg);
  font-family: var(--font-body);
  font-size: 16px;
  line-height: 1.55;
  font-kerning: normal;
  font-variant-numeric: oldstyle-nums proportional-nums;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  margin: 0;
  padding: calc(var(--space-base) * 6) 0;
}

/*
 * \`.page-sheet\` is the "piece of paper". Every spec wraps its content in
 * exactly one sheet. Width + min-height come from print dimensions; the
 * body background (above) provides the desk contrast so the sheet looks
 * like a physical object on screen.
 *
 * Orientation is driven by a body-level class set by the renderer from
 * \`spec.print.orientation\`:
 *   .orientation-portrait  → A4 portrait   (210mm × 297mm)
 *   .orientation-landscape → A4 landscape  (297mm × 210mm)
 *
 * Inner padding = \`spec.print.margin_mm\` (inlined as \`--sheet-margin\`) so
 * the on-screen text-box exactly matches what the printed page will have.
 */
.page-sheet {
  width: 210mm;
  min-height: 297mm;
  margin: 24px auto;
  background: var(--bg);
  color: var(--fg);
  box-shadow:
    0 2px 12px rgba(0, 0, 0, 0.12),
    0 0 0 1px rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.orientation-landscape .page-sheet {
  width: 297mm;
  min-height: 210mm;
}

.page-sheet-inner {
  padding: var(--sheet-margin, 18mm);
  min-height: 100%;
  box-sizing: border-box;
}

/*
 * Mobile: when viewport is narrower than an A4 sheet, scale the sheet
 * down proportionally so the whole page is visible as a small document
 * rather than overflowing. Keeps the "it is a printed page" reading
 * frame; trade-off is that hit-targets scale too.
 */
@media (max-width: 840px) {
  body { padding: 12px 0; }
  .page-sheet {
    transform: scale(calc((100vw - 24px) / 210mm));
    transform-origin: top center;
  }
  .orientation-landscape .page-sheet {
    transform: scale(calc((100vw - 24px) / 297mm));
  }
}

.page {
  max-width: var(--max-width);
  margin: 0 auto;
}

/* ---------- Typography defaults ---------- */

h1, h2, h3 {
  font-family: var(--font-headline);
  font-weight: 600;
  line-height: 1.15;
  color: var(--fg);
}

h1 { font-size: clamp(2rem, 3.5vw, 3.25rem); letter-spacing: -0.01em; }
h2 { font-size: 1.5rem; margin-top: calc(var(--space-base) * 6); }
h3 { font-size: 1.125rem; margin-top: calc(var(--space-base) * 4); }

p + p { margin-top: calc(var(--space-base) * 3); }

.label,
.block-label,
.provenance-strip,
.chrome-btn {
  font-family: var(--font-label);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.mono, time, .numeric { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

blockquote, .hero-quote, .pull-quote {
  font-family: var(--font-headline);
  font-size: 1.5rem;
  line-height: 1.3;
  font-style: italic;
  border-top: 1px solid var(--hairline);
  border-bottom: 1px solid var(--hairline);
  padding: calc(var(--space-base) * 4) 0;
  margin: calc(var(--space-base) * 6) 0;
}

/* ---------- Layout zones ---------- */
/*
 * The renderer drops a \`.layout layout-zones-<N>\` wrapper where N = number
 * of zones in spec.block_zones. Concrete visual layout per-zone-count is
 * defined below — each spec gets whatever zone count its JSON declares.
 */
.layout {
  display: grid;
  gap: var(--column-gap);
  grid-template-columns: 1fr;
}

/* 3-zone specs (executive-broadsheet: left / center / right).
   Center is the narrative spine, left / right flank it. */
.layout-zones-3 {
  grid-template-columns: 1.05fr 1.3fr 1fr;
  grid-template-areas: "left center right";
}
.layout-zones-3 > .zone-left   { grid-area: left; }
.layout-zones-3 > .zone-right  { grid-area: right; }
.layout-zones-3 > .zone-center { grid-area: center; order: 0; }

/* 1-zone specs (quiet-ledger single column). */
.layout-zones-1 { max-width: var(--max-width); }

/* guji-classical has 3 zones too (main / aside / epigraph) but wants
   vertical flow — for vertical-rl writing mode, grid auto-flips. */
.layout :where(.zone-main, .zone-aside, .zone-epigraph) { min-width: 0; }
.layout-zones-3 > .zone-main     { grid-area: left; }
.layout-zones-3 > .zone-aside    { grid-area: right; }
.layout-zones-3 > .zone-epigraph { grid-area: center; }

.zone {
  display: flex;
  flex-direction: column;
  gap: calc(var(--space-base) * 5);
  min-width: 0;
}

/* ---------- Masthead (spec-agnostic but token-styled) ---------- */

.masthead {
