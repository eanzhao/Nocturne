{
  "id": "keynote-sheet",
  "name": "Keynote Sheet",
  "description": "Single A4 landscape page, PPT-slide aesthetic. Use when the brief is essentially ONE point with 2-4 supporting beats. Planner MUST compress content to fit one page.",
  "writing_mode": "horizontal-lr",
  "fonts": {
    "headline": "'Inter', 'Söhne', -apple-system, BlinkMacSystemFont, sans-serif",
    "body":     "'Inter', 'Söhne', -apple-system, BlinkMacSystemFont, sans-serif",
    "label":    "'IBM Plex Mono', 'SF Mono', monospace",
    "mono":     "'IBM Plex Mono', 'SF Mono', monospace"
  },
  "palette": {
    "bg":       "#ffffff",
    "fg":       "#0a0a0a",
    "muted":    "#6b6b6b",
    "accent":   "#2f6feb",
    "hairline": "#0a0a0a"
  },
  "spacing": {
    "base": 8,
    "column_gap": 40,
    "column_count_desktop": 2,
    "max_width": 1100
  },
  "hero_priority_treatment": "single-only",
  "block_zones": {
    "lede":   ["summary"],
    "pillars":["top_priorities"]
  },
  "overflow_strategy": {
    "top_priorities": { "max": 3, "on_overflow": "truncate-hard" }
  },
  "pull_quote_role": "none",
  "severity_style": "none",
  "print": { "paper": "A4", "orientation": "landscape", "margin_mm": 20 }
}
