# ===== Server =====
PORT=7701
BASE_URL=http://localhost:7701
NODE_ENV=development

# ===== Supabase Postgres (Nocturne uses the `nocturne` schema) =====
# See ~/.supabase-credentials for the real value.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# ===== chrono-storage (HTML blob store, internal) =====
CHRONO_STORAGE_URL=http://127.0.0.1:3805
CHRONO_STORAGE_BUCKET=nocturne

# ===== NyxID (identity propagation + LLM Gateway) =====
NYXID_BASE_URL=https://nyx-api.chrono-ai.fun
NYXID_JWKS_URL=https://nyx-api.chrono-ai.fun/.well-known/jwks.json

# Secret used to HMAC-derive public user slugs for the archive URL.
# Must be at least 32 chars. Generate with: openssl rand -hex 32
NYXID_SERVICE_SECRET=change-me-openssl-rand-hex-32

# ===== Slug entropy =====
# base62(PAGE_ID_BYTES random bytes). 15 bytes ≈ 120 bits; do not go below 12.
PAGE_ID_BYTES=15
