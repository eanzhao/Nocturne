# ===== Server =====
PORT=7701
BASE_URL=http://localhost:7701
NODE_ENV=development

# ===== Supabase Postgres (Nocturne uses the `nocturne` schema) =====
# See ~/.supabase-credentials for the real value.
DATABASE_URL=postgresql://postgres:password@host:5432/postgres

# ===== chrono-storage (HTML blob store, internal) =====
CHRONO_STORAGE_URL=http://127.0.0.1:3805
CHRONO_STORAGE_BUCKET=nocturne

# ===== NyxID (identity propagation + LLM Gateway) =====
NYXID_BASE_URL=https://nyx-api.chrono-ai.fun
NYXID_JWKS_URL=https://nyx-api.chrono-ai.fun/.well-known/jwks.json

# Identity-assertion JWT claims NyxID mints for this service. Both MUST match
# NyxID's server-side config exactly; wrong values → every real request 401s.
#   NYXID_JWT_ISSUER   = NyxID's `jwt_issuer` config string
#   NYXID_JWT_AUDIENCE = downstream service's `identity_jwt_audience` (or its
#                        `base_url` if that column is null)
# Ask the NyxID admin for the right values.
NYXID_JWT_ISSUER=https://nyx-api.chrono-ai.fun
NYXID_JWT_AUDIENCE=https://nocturne.eanzhao.com

# Secret used to HMAC-derive public user slugs for the archive URL.
# Must be at least 32 chars. Generate with: openssl rand -hex 32
NYXID_SERVICE_SECRET=change-me-openssl-rand-hex-32
# ===== Static-bearer escape hatch (DO NOT USE in production without runbook) =====
# Fails closed by default. To activate, BOTH vars must be set:
#   NOCTURNE_STATIC_BEARER       = shared secret (≥32 chars)
#   NOCTURNE_STATIC_BEARER_FORCE = "1"
# If either is missing, the bypass is disabled regardless of NODE_ENV. This
# is on purpose — a missing NODE_ENV should never silently open the bypass.
# When active, Authorization: Bearer <secret> is accepted as the fixed admin
# user (00000000-0000-0000-0000-000000000001) and every match is logged.
# NOCTURNE_STATIC_BEARER=
# NOCTURNE_STATIC_BEARER_FORCE=0

# ===== Slug entropy =====
# base62(PAGE_ID_BYTES random bytes). 15 bytes ≈ 120 bits; do not go below 12.
PAGE_ID_BYTES=15

# ===== Local CLI mode (src/cli/format.ts) =====
# Required; any OpenAI-compatible API key.
NOCTURNE_OPENAI_API_KEY=
# Any OpenAI-compatible base URL. Examples:
#   OpenAI:        https://api.openai.com/v1
#   OpenRouter:    https://openrouter.ai/api/v1
#   Local llama:   http://localhost:8080/v1
NOCTURNE_OPENAI_BASE_URL=https://api.openai.com/v1
NOCTURNE_OPENAI_MODEL=gpt-4o-mini
NOCTURNE_OUT_DIR=./out
